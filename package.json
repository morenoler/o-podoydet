{
  "name": "o-podoydet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lab:build": "node scripts/lab.mjs build",
    "lab:start": "node --env-file-if-exists=.env scripts/lab.mjs start",
    "ollama:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ollama-local.ps1",
    "ollama:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-local-model.ps1",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:spring": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env scripts/backend.mjs start",
    "test": "tsx --test tests/*.test.ts",
    "data:fetch": "tsx scripts/fetch-osm.ts",
    "data:fetch:busan": "tsx scripts/fetch-busan.ts --fetch",
    "data:prepare:busan": "tsx scripts/prepare-busan.ts",
    "data:fetch:sochi": "tsx scripts/fetch-sochi.ts --fetch",
    "data:prepare:sochi": "tsx scripts/prepare-sochi.ts",
    "data:prepare": "tsx scripts/prepare-data.ts && tsx scripts/prepare-verified-data.ts",
    "data:verify": "tsx scripts/prepare-verified-data.ts",
    "check": "tsc --noEmit",
    "backend:build": "node --env-file-if-exists=.env scripts/backend.mjs build",
    "backend:test": "node --test scripts/backend.test.mjs && node --env-file-if-exists=.env scripts/backend.mjs test",
    "server:build": "node --env-file-if-exists=.env scripts/backend.mjs build",
    "server:test": "node --env-file-if-exists=.env scripts/backend.mjs test",
    "contract:capture": "node scripts/contract.mjs capture --base http://127.0.0.1:8080",
    "contract:check": "node scripts/contract.mjs check --base http://127.0.0.1:8080",
    "contract:verify": "node --env-file-if-exists=.env scripts/contract-verify.mjs",
    "agents:test": "node --env-file-if-exists=.env scripts/agents-test.mjs",
    "test:all": "npm test && npm run backend:test && npm run agents:test && npm run demo:test",
    "build:all": "npm run build && npm run backend:build",
    "area:assess": "tsx --env-file-if-exists=.env scripts/assess-area.ts",
    "traffic:fetch": "tsx --env-file-if-exists=.env scripts/fetch-traffic.ts",
    "noise:assess": "tsx --env-file-if-exists=.env scripts/assess-noise.ts",
    "data:collect": "tsx scripts/import-official-hotel-pages.ts",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:setup": "node scripts/demo.mjs setup",
    "demo:start": "node --env-file-if-exists=.env scripts/demo.mjs start",
    "demo:test": "node --test scripts/demo.test.mjs",
    "db:up": "docker compose up -d --wait db",
    "backend:launcher:test": "node --test scripts/backend.test.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.2.8",
    "@fontsource/nunito-sans": "^5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
