PORT=8080
BIND_ADDRESS=127.0.0.1
# API (Spring Boot): 8080. Интерфейс Vite в режиме разработки: 3000.
# PostgreSQL + PostGIS поднимается из docker-compose.yml. Своя база:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/opodoydet
# DATABASE_USER=opodoydet
# DATABASE_PASSWORD=opodoydet
# Схема копии сайта: public (основной), lab, demo.
# DB_SCHEMA=public
# Явный однократный импорт прежней SQLite в выбранную схему PostgreSQL.
# Исходный файл не изменяется. DB_PATH сам по себе импорт не включает.
# LEGACY_DB_PATH=.local/busan.sqlite3
# Кабинеты включены по умолчанию в основной и лабораторной версиях.
ACCOUNT_MODE=true
# Постоянное хранилище фото отдельно от dist/. Резервируйте вместе с PostgreSQL.
UPLOADS_PATH=.local/uploads
# Для сервера за HTTPS включите защищённые cookie.
SESSION_COOKIE_SECURE=false
DATA_PATH=data/verified-hotels.json
AREA_DATA_PATH=data/area-assessments.json
NOISE_DATA_PATH=data/noise-context.json
TRAFFIC_DATA_PATH=data/traffic-ktdb-2024.json

# Поиск и чат всегда используют локальные правила, без вызовов LLM.
# Необязательно: модель для отдельного разбора неоднозначного ответа отельера.
# Однозначные ответы разбираются локально даже при заданных ключе и модели.
# Провайдер должен поддерживать POST /responses и строгую JSON Schema.
# Заполняйте секреты только в .env; не коммитьте его.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1

# Отдельный сервис геометрической оценки вида из окна.
WINDOW_VIEW_URL=http://127.0.0.1:8011
# Помощник подбора: Python 3.11+, стандартная библиотека, без pip install.
# Основной интерфейс всегда запускает rules: без модели и оплаты API.
ADVISOR_PYTHON=python
# Необязательно: уже загруженная локальная модель Ollama.
# ADVISOR_LOCAL_MODEL=
# ADVISOR_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# Внешние платные провайдеры в помощнике не поддерживаются.
# Ключи LLM_* выше не используются поиском, чатом или подробным помощником.
# Локальная установка и отдельная копия сайта: docs/LOCAL_AI_LAB.md.
# После npm run ollama:prepare:
# ADVISOR_LOCAL_MODEL=opodoydet-local
# LAB_PORT=8081
# LAB_DB_SCHEMA=lab
# LAB_LEGACY_DB_PATH=.local/lab.sqlite3
# LAB_UPLOADS_PATH=.local/lab-uploads
# DEMO_PORT=8082
