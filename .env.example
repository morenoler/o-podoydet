PORT=8080
# Провайдер по умолчанию для модельных путей Java и Python.
# На сайте «Модель ИИ» меняет провайдера для следующих запросов этого браузера.
# Для выбора обоих провайдеров заполните DEEPSEEK_* и ADVISOR_LOCAL_* одновременно.
# Пустое значение сохраняет прежние LLM_* / ADVISOR_LOCAL_* настройки.
# AI_PROVIDER=rules полностью отключает модели; local выбирает ADVISOR_LOCAL_*.
# Для DeepSeek по умолчанию:
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_MAX_TOKENS=1200
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Ключ только на сервере, без VITE_ префикса. Подробности: docs/DEEPSEEK_MODULE.md.
# Без ключа доступен спутник ESA WorldCover 2021 (10 м; тайлы до z14, приближение до z19).
# Собственный браузерный ArcGIS key включает подробные спутниковые снимки.
# Ограничьте разрешённые домены/referrers в ArcGIS; этот ключ виден браузеру.
# VITE_ARCGIS_API_KEY=
# После изменения пересоберите интерфейс. Без ключа используется OpenStreetMap.
# Подробности: docs/SATELLITE_MAP_QUALITY.md. DeepSeek-ключ сюда не вставлять.
BIND_ADDRESS=127.0.0.1
# API (Spring Boot): 8080. Интерфейс Vite в режиме разработки: 3000.
# PostgreSQL + PostGIS поднимается из docker-compose.yml. Своя база:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/opodoydet
# DATABASE_USER=opodoydet
# DATABASE_PASSWORD=opodoydet
# Схема копии сайта: public (основной), lab, demo.
# DB_SCHEMA=public
# Явный однократный импорт прежней SQLite в выбранную схему PostgreSQL.
# Исходный файл не изменяется. DB_PATH сам по себе импорт не включает.
# LEGACY_DB_PATH=.local/busan.sqlite3
# Кабинеты включены по умолчанию в основной и лабораторной версиях.
ACCOUNT_MODE=true
# Постоянное хранилище фото отдельно от dist/. Резервируйте вместе с PostgreSQL.
UPLOADS_PATH=.local/uploads
# Для сервера за HTTPS включите защищённые cookie.
SESSION_COOKIE_SECURE=false
# Пустое DATA_PATH загружает Пусан и Сочи. Явный путь включает только один набор.
DATA_PATH=
# DATA_PATH=data/sochi/verified-hotels.json
AREA_DATA_PATH=data/area-assessments.json
NOISE_DATA_PATH=data/noise-context.json
TRAFFIC_DATA_PATH=data/traffic-ktdb-2024.json

# Прежние раздельные настройки применяются только при пустом AI_PROVIDER.
# Необязательно: модель для отдельного разбора неоднозначного ответа отельера.
# Однозначные ответы разбираются локально даже при заданных ключе и модели.
# Провайдер должен поддерживать POST /responses и строгую JSON Schema.
# Заполняйте секреты только в .env; не коммитьте его.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1

# Отдельный сервис геометрической оценки вида из окна.
WINDOW_VIEW_URL=http://127.0.0.1:8011
# Помощник подбора: Python 3.11+, стандартная библиотека, без pip install.
# Основной интерфейс использует настройку сервера либо выбор «Модель ИИ».
ADVISOR_PYTHON=python
# Если Java запускается из другой папки: абсолютный путь к корню с agents/.
# ADVISOR_ROOT=C:/path/to/o-podoydet
# Необязательно: уже загруженная локальная модель Ollama.
# ADVISOR_LOCAL_MODEL=
# ADVISOR_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# DeepSeek включается явно через AI_PROVIDER=deepseek либо выбором на сайте.
# При AI_PROVIDER=deepseek локальная модель остаётся доступна для выбора на сайте.
# Локальная установка и отдельная копия сайта: docs/LOCAL_AI_LAB.md.
# После npm run ollama:prepare:
# ADVISOR_LOCAL_MODEL=opodoydet-local
# LAB_PORT=8081
# LAB_DB_SCHEMA=lab
# LAB_LEGACY_DB_PATH=.local/lab.sqlite3
# LAB_UPLOADS_PATH=.local/lab-uploads
# DEMO_PORT=8082
